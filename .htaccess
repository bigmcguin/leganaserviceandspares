# Protects files that must never be public. Do not remove.
# Hostinger copies the whole repository into public_html, so these rules
# stop visitors reading CLAUDE.md, the .claude/ folder, .git and any other
# hidden file or folder. Requests for them get a plain 404.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_alias.c>
  # Any path segment starting with a dot (.git, .claude, .htaccess, .gitkeep),
  # except .well-known/, which is needed for SSL certificate checks.
  RedirectMatch 404 (?i)(^|/)\.(?!well-known(/|$))
  # Claude's project instructions
  RedirectMatch 404 (?i)(^|/)CLAUDE\.md$
</IfModule>

# Fallback if mod_alias is unavailable: refuse access instead.
<IfModule !mod_alias.c>
  <FilesMatch "(?i)^(CLAUDE\.md|\..+)$">
    Require all denied
  </FilesMatch>
  RewriteEngine On
  RewriteRule (^|/)\.(?!well-known(/|$)) - [F]
</IfModule>

# ---------------------------------------------------------------------------
# Speed: compression and browser caching.
# Images and fonts are cached for a year: when replacing one, save it under a
# new file name so visitors get the new version. CSS and JavaScript are kept
# for a day so changes reach visitors quickly. Pages are always rechecked.
# ---------------------------------------------------------------------------

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
